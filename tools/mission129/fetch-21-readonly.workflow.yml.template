# Mission 129: INSTALL BY OWNER as .github/workflows/mission129-fetch-21.yml on the DEFAULT branch. NOT installed by Claude
# (the GitHub App cannot write .github/workflows). Nothing here has been run.
# WHY a separate fixed step: anthropics/claude-code-action sets process.env.GH_TOKEN = <its own GitHub App token> inside the
# Claude step (src/entrypoints/run.ts:191), overwriting a GH_TOKEN passed via the step `env:`. So `gh release view -R <private repo>`
# inside Claude runs with the App token, which cannot see livecity-3d-data -> "release not found". The READ PAT never reaches gh there.
# This workflow instead uses the READ PAT only in ONE curl step (no Claude, no repo code, GET only), writes to RUNNER_TEMP (outside the
# repo), runs the repo-pinned read-only data check, and uploads NOTHING (no artifacts, no private bytes in logs).
name: Mission129 read-only fetch and data check (21 wards)
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: mission129-fetch-21
  cancel-in-progress: false
env:
  DATA_REPO: masamasa26346497-eng/livecity-3d-data
  TAG: plateau2025-converted
jobs:
  fetch-check:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    if: github.actor == github.repository_owner && github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    steps:
      - name: Checkout the PR branch tooling (read-only, token not persisted)
        uses: actions/checkout@v4
        with:
          ref: claude/issue-23-20261007-1424
          persist-credentials: false
          fetch-depth: 1
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Fetch 21 archives (READ token only here; GET only; into RUNNER_TEMP)
        env:
          READ_TOKEN: ${{ secrets.LIVECITY_3D_DATA_READ_TOKEN }}
        run: |
          set -eu
          [ -n "$READ_TOKEN" ] || { echo "FAIL: LIVECITY_3D_DATA_READ_TOKEN empty or missing"; exit 1; }
          echo "::add-mask::$READ_TOKEN"
          get() { printf 'header = "Authorization: Bearer %s"\n' "$READ_TOKEN" | curl -sS -K - -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' -o "$2" -w '%{http_code}' "$1"; }
          code=$(get "https://api.github.com/repos/$DATA_REPO/releases/tags/$TAG" "$RUNNER_TEMP/rel.json" || true)
          echo "release GET -> HTTP $code"
          [ "$code" = "200" ] || exit 1
          mkdir -p "$RUNNER_TEMP/b21"
          wards=$(node tools/mission129/wards21.cjs --list | sed 's/^[0-9]* wards: //' | tr ',' ' ')
          [ "$(echo $wards | wc -w)" = "21" ] || { echo "FAIL: ward list is not 21"; exit 1; }
          ok=0
          for w in $wards; do
            id=$(jq -r --arg a "plateau2025-$w.tar.gz" '.assets[]|select(.name==$a)|.id' "$RUNNER_TEMP/rel.json" | head -n1)
            [ -n "$id" ] || { echo "[$w] asset missing"; continue; }
            printf 'header = "Authorization: Bearer %s"\n' "$READ_TOKEN" | curl -sSL --fail -K - -H 'Accept: application/octet-stream' -o "$RUNNER_TEMP/$w.tgz" "https://api.github.com/repos/$DATA_REPO/releases/assets/$id" || { echo "[$w] download failed"; continue; }
            tar -tzf "$RUNNER_TEMP/$w.tgz" | grep -q 'tileset.json' || { echo "[$w] no tileset.json in archive"; rm -f "$RUNNER_TEMP/$w.tgz"; continue; }
            tar -xzf "$RUNNER_TEMP/$w.tgz" -C "$RUNNER_TEMP/b21"
            echo "[$w] sha256=$(sha256sum "$RUNNER_TEMP/$w.tgz" | cut -d' ' -f1) bytes=$(stat -c %s "$RUNNER_TEMP/$w.tgz")"
            rm -f "$RUNNER_TEMP/$w.tgz"; ok=$((ok+1))
          done
          echo "fetched+extracted: $ok / 21"
      - name: Data-level check (no token; not browser acceptance)
        run: node tools/mission129/wards21.cjs --check "$RUNNER_TEMP/b21" | tee -a "$GITHUB_STEP_SUMMARY"
